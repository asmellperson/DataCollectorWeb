DEVICE=cpu
# GPU 驱动可用时改为 DEVICE=cuda:0
# WORLD_MODEL=/usr/zyy/DataCollectorWeb/models/yolov8s-worldv2.pt
# SCRFD 人脸五点：仅在实际部署服务器加载，不自动下载，不影响其他功能启动。
SCRFD_MODEL_PATH=/srv/models/insightface/buffalo_l/det_10g.onnx
# A100 服务器将视频、标注、训练清单及平台状态放在 /data。
# DATA_ROOT=/data/DataCollectorWeb/datasets
# STATE_ROOT=/data/DataCollectorWeb/state
# 安检辅助标注复用已有千问服务；认证密钥只通过服务器环境提供。
# INSPECTION_VLM_BASE_URL=http://127.0.0.1:18100/v1
# INSPECTION_VLM_MODEL=fuda-qwen38-27b
# INSPECTION_VLM_TIMEOUT_SEC=120
# INSPECTION_VLM_MAX_TOKENS=8192
# INSPECTION_VLM_API_KEY=
